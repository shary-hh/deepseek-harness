# Spec generado desde packaging/rpm/deepseek-harness.spec.in
# No edites el .spec generado: edita la plantilla.
%global debug_package %{nil}
%global __strip /bin/true
%global __objdump /bin/true

Name:           @APP_NAME@
Version:        @VERSION@
Release:        1
Summary:        @SUMMARY@
License:        @LICENSE@
URL:            @URL@
Packager:       @MAINTAINER@
AutoReqProv:    no

%description
@LONG@

%prep

%build

%install
rm -rf %{buildroot}
install -d %{buildroot}/opt/@APP_NAME@
cp -a %{_sourcedir}/payload/. %{buildroot}/opt/@APP_NAME@/
rm -rf %{buildroot}/opt/@APP_NAME@/share

install -d %{buildroot}%{_bindir}
ln -s /opt/@APP_NAME@/bin/@APP_BIN@ %{buildroot}%{_bindir}/@APP_BIN@

install -d %{buildroot}%{_mandir}/man1
gzip -9n -c %{_sourcedir}/@APP_BIN@.1 > %{buildroot}%{_mandir}/man1/@APP_BIN@.1.gz
chmod 0644 %{buildroot}%{_mandir}/man1/@APP_BIN@.1.gz

install -d %{buildroot}%{_datadir}/licenses/%{name}
install -m 0644 %{_sourcedir}/LICENSE %{buildroot}%{_datadir}/licenses/%{name}/LICENSE

%files
%defattr(-,root,root,-)
/opt/@APP_NAME@
%{_bindir}/@APP_BIN@
%{_mandir}/man1/@APP_BIN@.1.gz
%{_datadir}/licenses/%{name}/LICENSE

%changelog
* @CHANGELOG_DATE@ @MAINTAINER@ - @VERSION@-1
- Empaquetado para Fedora/RHEL generado por el repositorio de empaquetado.
