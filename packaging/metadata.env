# shellcheck shell=bash
# ---------------------------------------------------------------------------
# Metadatos centralizados del proyecto.
#
# Edita SOLO este archivo para cambiar nombre, descripción, homepage, etc.
# No pongas correos personales ni credenciales aquí: este archivo se publica.
#
# APP_HOMEPAGE: si dejas "OWNER" el script intentará deducir el owner/repo
# desde `git remote get-url origin`. Si no hay remoto, se usa el placeholder.
# ---------------------------------------------------------------------------

APP_NAME="deepseek-harness"
APP_BIN="deepseek-harness"
APP_VENDOR="DeepSeek Harness Contributors"
APP_MAINTAINER="DeepSeek Harness Maintainers <maintainers@users.noreply.github.com>"
APP_HOMEPAGE="https://github.com/OWNER/deepseek-harness"
APP_LICENSE="GPL-3.0-or-later"
APP_SECTION="utils"
APP_CATEGORY="Development"
APP_DESC="CLI for the DeepSeek API"
APP_LONG_DESC="Command line client for the DeepSeek API with streaming responses, local configuration and no stored secrets."
APP_KEYWORDS="deepseek;cli;ai;harness"

# Versión de Node.js que se empaqueta (LTS). Se verifica contra SHA256SUMS256.txt
# descargado de nodejs.org y contra el hash fijado en scripts/lib/node.sh.
DH_NODE_VERSION="${DH_NODE_VERSION:-24.22.1}"

# Repositorio (owner/repo). Vacío = autodetectar desde git.
DH_REPO_SLUG="${DH_REPO_SLUG:-}"
